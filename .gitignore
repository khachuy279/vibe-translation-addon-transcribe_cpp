# ==========================================
# Vibe Translation Addon — .gitignore
# ==========================================

# 1. User specified exclusions: Sub-repos & external directories
external/
debug/
scratch/

# 2. Models & Model Weights (large files > 50MB)
backend/models/
models/
*.gguf
*.bin
*.pt
*.pth
*.onnx
*.safetensors
*.engine
*.blob

# 2b. Native Binaries & Large CUDA DLLs
# *.dll
*.exe
*.so
*.dylib
*.lib

# 3. Security & Certificates
*.pem
*.key
backend/cert.pem
backend/key.pem

# 4. Audio Dumps & Large Test Artifacts
debug_audio/
data/
scratch/
*.log

# 5. Compressed Archives
*.zip
*.tar
*.tar.gz
*.tar.bz2
*.7z
*.rar

# 6. Python Cache & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
env/
ENV/

# 7. IDE, OS & System Files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# 8. Temporary Performance Reports & Logs
perf_report.json
perf_report_summary.txt
# Sinh ra khi phiên WS kết thúc hoặc khi shutdown (xem backend/core/metrics.py
# ::dump_metrics_report). Là artifact đo đạc, không phải mã nguồn.
metrics_report.json
# Bản đã đổi tên để so A/B (metrics_sched_ON.json / metrics_sched_OFF.json)
metrics_sched_*.json

# 9. G2/G3 — bản dựng CUDA ASR & toolchain cục bộ (không commit)
# bin/                  : bundle native lúc chạy (transcribe.dll + ggml*.dll, gồm
#                         ggml-cuda.dll, tổng ~121 MB). Ứng dụng nạp từ đây qua
#                         TRANSCRIBE_LIBRARY (backend/asr/native.py).
#                         QUYẾT ĐỊNH §4.2: đã `git rm --cached bin/*.dll` — DLL không
#                         còn được theo dõi git (mỗi lần build lại CUDA tạo diff nhị
#                         phân 68 MB). Chặn tường minh ở đây để `git status` sạch;
#                         bundle phân phối lại bằng script build trong external/.
#                         LƯU Ý: git KHÔNG còn backup cho bin/ nữa.
# external/cuda-toolkit : CUDA toolkit dựng từ wheel pip (nvcc/cublas/headers) ~1,4 GB
# external/build-cuda   : cây build CMake của transcribe.cpp với backend CUDA
# external/build-tmp    : log/script/JSON tạm của quá trình đo G2/G3
# (external/ đã bị chặn ở mục 1; các mục con dưới đây chỉ để tài liệu hoá.)
# bin/
external/cuda-toolkit/
external/build-cuda/
external/build-tmp/


# 10. WAV
wav_test/google_fleurs
# Junction tr? t?i external/build-cuda v� external/cuda-toolkit: CMakeCache/ninja trong
# external/build-cuda ghi du?ng d?n tuy?t d?i d?ng .build-cuda/.cuda-toolkit, n�n 2 junction n�y
# gi? cho vi?c build l?i CUDA ho?t d?ng m� kh�ng ph?i sinh l?i cache t? d?u.
/.build-cuda/
/.cuda-toolkit/
