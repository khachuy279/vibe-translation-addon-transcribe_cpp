# external/build-cuda ghi du?ng d?n tuy?t d?i d?ng .build-cuda/.cuda-toolkit, n�n 2 junction n�y
# gi? cho vi?c build l?i CUDA ho?t d?ng m� kh�ng ph?i sinh l?i cache t? d?u.
/.build-cuda/
/.cuda-toolkit/
wav_test/vad
