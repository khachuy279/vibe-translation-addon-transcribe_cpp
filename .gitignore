# ==========================================
# Vibe Translation Addon — .gitignore
# ==========================================

# 1. User specified exclusions: Sub-repos & external directories
external/
debug/
scratch/

# 2. Models & Model Weights (large files > 50MB)
backend/models/
models/
*.gguf
*.bin
*.pt
*.pth
*.onnx
*.safetensors
*.engine
*.blob

# 2b. Native Binaries & Large CUDA DLLs
# *.dll
*.exe
*.so
*.dylib
*.lib

# 3. Security & Certificates
*.pem
*.key
backend/cert.pem
backend/key.pem

# 4. Audio Dumps & Large Test Artifacts
debug_audio/
data/
scratch/
*.log

# 5. Compressed Archives
*.zip
*.tar
*.tar.gz
*.tar.bz2
*.7z
*.rar

# 6. Python Cache & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
env/
ENV/

# 7. IDE, OS & System Files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# 8. Temporary Performance Reports & Logs
perf_report.json
perf_report_summary.txt
# Sinh ra khi phiên WS kết thúc hoặc khi shutdown (xem backend/core/metrics.py
# ::dump_metrics_report). Là artifact đo đạc, không phải mã nguồn.
metrics_report.json
# Bản đã đổi tên để so A/B (metrics_sched_ON.json / metrics_sched_OFF.json)
metrics_sched_*.json

# 9. G2/G3 — bản dựng CUDA ASR & toolchain cục bộ (không commit)
# bin/                  : bundle native lúc chạy (transcribe.dll + ggml*.dll, gồm
#                         ggml-cuda.dll). Ứng dụng nạp từ đây qua TRANSCRIBE_LIBRARY
#                         (backend/asr/native.py). Nội dung đều là *.dll nên đã bị mục 2b
#                         chặn; khai báo thêm cho tường minh.
# external/cuda-toolkit : CUDA toolkit dựng từ wheel pip (nvcc/cublas/headers) ~1,4 GB
# external/build-cuda   : cây build CMake của transcribe.cpp với backend CUDA
# external/build-tmp    : log/script/JSON tạm của quá trình đo G2/G3
# (external/ đã bị chặn ở mục 1; các mục con dưới đây chỉ để tài liệu hoá.)
# bin/
external/cuda-toolkit/
external/build-cuda/
external/build-tmp/
