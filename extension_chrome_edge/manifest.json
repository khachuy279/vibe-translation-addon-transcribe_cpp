{
  "manifest_version": 3,
  "name": "Bilingual Subtitle",
  "version": "0.6.8",
  "description": "Real-time bilingual subtitles for videos using transcribe.cpp",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>",
    "wss://localhost:8765/*",
    "https://localhost:8765/*",
    "http://localhost:8765/*",
    "http://localhost:1234/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; connect-src 'self' wss://localhost:8765 ws://localhost:8765 https://localhost:8765 http://localhost:8765 http://localhost:1234"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "js": [
        "content/buffer_interceptor_poc.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "js": [
        "lib/browser-config.js",
        "lib/lookahead-diagnostics.js",
        "lib/frame-builder.js",
        "lib/tts-player.js",
        "lib/ws-client.js",
        "lib/audio-capture.js",
        "lib/subtitle-policy.js",
        "lib/subtitle-renderer.js",
        "lib/tts-timeline.js",
        "lib/lookahead-timeline.js",
        "lib/lookahead-client.js",
        "content/overlay-manager.js",
        "content/content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Bilingual Subtitle",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "lib/audio-processor.js",
        "content/buffer_interceptor_poc.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}